# Copia este archivo a `.env` y rellena los valores que apliquen.
# Ninguna clave es obligatoria para ejecutar el proyecto en modo OFFLINE
# (recuperación TF-IDF + respuesta grounded sin LLM externo).

# --- Configuración general del RAG ---
# Modo de recuperación/embeddings: "offline" (por defecto, sin dependencias de red)
# o "llama_index" si tienes instalado el stack opcional.
RAG_MODE=offline

# Proveedor de embeddings cuando RAG_MODE=llama_index: "openai" | "local"
EMBEDDING_PROVIDER=local

# Modelo de lenguaje para generar la respuesta:
# "offline"  -> respuesta compuesta a partir de los fragmentos recuperados (sin API).
# "openai"   -> usa la API de OpenAI (requiere OPENAI_API_KEY).
# "anthropic"-> usa la API de Anthropic (requiere ANTHROPIC_API_KEY).
LLM_PROVIDER=offline
LLM_MODEL=gpt-4o-mini

# --- Credenciales (NUNCA se commitean; ver .gitignore) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Rutas ---
KNOWLEDGE_DIR=knowledge
INDEX_DIR=rag/.index
